
---

# 📌 **.env.example**
```env
#########################################
#             BACKEND CONFIG
#########################################

PORT=8080
NODE_ENV=development

# Security
JWT_SECRET=change_this_secret
ADMIN_PASSWORD=change_admin_password

#########################################
#              SOLANA
#########################################

SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PRIVATE_KEY=PASTE_YOUR_PRIVATE_KEY_ARRAY

# Switchboard
SWITCHBOARD_PROGRAM_ID=
SWITCHBOARD_QUEUE=
SWITCHBOARD_PERMISSIONLESS_QUEUE=true

#########################################
#                 EVM
#########################################

EVM_NETWORK=polygon_amoy
EVM_RPC_URL=https://rpc-amoy.polygon.technology

EVM_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
CASINO_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
RNG_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Chainlink VRF
CHAINLINK_VRF_SUBSCRIPTION_ID=
CHAINLINK_VRF_KEYHASH=
CHAINLINK_VRF_COORDINATOR=

#########################################
#             GAME SETTINGS
#########################################

HOUSE_EDGE=0.02
MIN_BET=0.1
MAX_BET=10

#########################################
#           BANKROLL SETTINGS
#########################################

INITIAL_BANKROLL=1000
MAX_PAYOUT_RATIO=0.2
EXPOSURE_LIMIT=0.35

#########################################
#            FRONTEND CONFIG
#########################################

NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

