
#########################################
#             BACKEND CONFIG
#########################################

PORT=8080
NODE_ENV=development

# Security
JWT_SECRET=change_this_secret
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MONGO_URI=mongodb://127.0.0.1:27017/solcasino?replicaSet=rs0&directConnection=true
AUTH_DOMAIN=localhost:3000
AUTH_URI=http://localhost:3000

#########################################
#              SOLANA
#########################################

SOLANA_NETWORK=devnet
# Disabled is the only safe default. Do not reuse undocumented/legacy keys.
CUSTODY_MODE=disabled

# Switchboard
SWITCHBOARD_PROGRAM_ID=
SWITCHBOARD_QUEUE=
SWITCHBOARD_PERMISSIONLESS_QUEUE=true

#########################################
#                 EVM
#########################################

EVM_NETWORK=arbitrum
EVM_RPC_URL=https://arb1.arbitrum.io/rpc

# No private keys belong in application environment variables. Any future signing
# must use an approved provider/MPC/HSM integration.
CASINO_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
RNG_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Chainlink VRF
CHAINLINK_VRF_SUBSCRIPTION_ID=
CHAINLINK_VRF_KEYHASH=
CHAINLINK_VRF_COORDINATOR=

#########################################
#             GAME SETTINGS
#########################################

HOUSE_EDGE=0.02
MIN_BET=0.1
MAX_BET=10

#########################################
#           BANKROLL SETTINGS
#########################################

# Safe default: all gameplay is blocked until a provider is explicitly selected.
BANKROLL_PROVIDER=disabled
# Internal bankroll is only a deterministic local/test provider and is forbidden in production.
BANKROLL_INTERNAL_TEST_MODE=disabled
BANKROLL_INTERNAL_LIQUIDITY_MINOR=100000000000
BANKROLL_INTERNAL_MAX_BET_MINOR=1000000000
# WINR remains disabled until a verified operator API/contract transport, chain IDs,
# contract addresses and non-legacy signing/custody controls are supplied.
WINR_OPERATOR_MODE=disabled

#########################################
#             SPORTSBOOK
#########################################

# Safe default. External providers require a signed agreement, verified schemas,
# credentials, settlement fixtures and an independent integration review.
SPORTSBOOK_PROVIDER=disabled
SPORTSBOOK_SANDBOX_MODE=disabled
CASINO_CATALOG_PROVIDER=disabled
CASINO_CATALOG_SANDBOX_MODE=disabled
SPORTSBOOK_SANDBOX_MAX_PAYOUT_MINOR=10000000000

#########################################
#            FRONTEND CONFIG
#########################################

NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080/api
# WalletConnect Cloud project ID. Leave blank for local injected-wallet fallback.
NEXT_PUBLIC_WC_PROJECT_ID=
